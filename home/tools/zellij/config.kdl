// Zellij base config — generated/wired by home/tools/zellij/default.nix
// Keybinds mirror the niri vocabulary so muscle memory is shared:
//   Alt+HJKL = focus, Alt+Shift+HJKL = move, Alt+1..9 = tab, Alt+Enter = new pane,
//   Alt+W = close, Alt+F = float, Alt+Shift+F = fullscreen, Alt+T = new tab.
// The `Alt` modifier fires on either Left or Right Alt because zellij does not
// expose a separate Right-Alt mod. The companion niri xkb option ensures
// Right Alt always emits Alt regardless of layout.

theme "dms"
default_layout "default"
default_mode "normal"
mouse_mode true
copy_on_select true
copy_command "wl-copy"
pane_frames false
simplified_ui true
show_startup_tips false
show_release_notes false
session_serialization true
serialize_pane_viewport true
scrollback_lines_to_serialize 10000

ui {
    pane_frames {
        rounded_corners true
        hide_session_name true
    }
}

keybinds clear-defaults=true {
    shared_except "locked" "renametab" "renamepane" "entersearch" {
        bind "Alt h" { MoveFocus "Left"; }
        bind "Alt j" { MoveFocus "Down"; }
        bind "Alt k" { MoveFocus "Up"; }
        bind "Alt l" { MoveFocus "Right"; }

        bind "Alt H" { MovePane "Left"; }
        bind "Alt J" { MovePane "Down"; }
        bind "Alt K" { MovePane "Up"; }
        bind "Alt L" { MovePane "Right"; }

        bind "Alt Enter" { NewPane; }
        bind "Alt v"     { NewPane "Right"; }
        bind "Alt s"     { NewPane "Down"; }

        bind "Alt w" { CloseFocus; }
        bind "Alt f" { ToggleFloatingPanes; }
        bind "Alt F" { ToggleFocusFullscreen; }
        bind "Alt z" { TogglePaneFrames; }

        bind "Alt t" { NewTab; }
        bind "Alt W" { CloseTab; }
        bind "Alt Tab"   { ToggleTab; }
        bind "Alt r"     { SwitchToMode "RenameTab"; TabNameInput 0; }

        bind "Alt 1" { GoToTab 1; }
        bind "Alt 2" { GoToTab 2; }
        bind "Alt 3" { GoToTab 3; }
        bind "Alt 4" { GoToTab 4; }
        bind "Alt 5" { GoToTab 5; }
        bind "Alt 6" { GoToTab 6; }
        bind "Alt 7" { GoToTab 7; }
        bind "Alt 8" { GoToTab 8; }
        bind "Alt 9" { GoToTab 9; }

        bind "Alt {" { MoveTab "Left"; }
        bind "Alt }" { MoveTab "Right"; }

        bind "Alt =" "Alt +" { Resize "Increase"; }
        bind "Alt -"         { Resize "Decrease"; }

        bind "Alt p" { SwitchToMode "Pane"; }
        bind "Alt R" { SwitchToMode "Resize"; }
        bind "Alt o" { SwitchToMode "Session"; }
        bind "Alt /" { SwitchToMode "Search"; }

        bind "Alt d" { Detach; }
        bind "Alt q" { Quit; }
        bind "Alt g" { SwitchToMode "Locked"; }
    }

    locked {
        bind "Alt g" { SwitchToMode "Normal"; }
    }

    pane {
        bind "Esc" "Alt p" { SwitchToMode "Normal"; }
        bind "h" { MoveFocus "Left"; }
        bind "l" { MoveFocus "Right"; }
        bind "j" { MoveFocus "Down"; }
        bind "k" { MoveFocus "Up"; }
        bind "x" { CloseFocus; SwitchToMode "Normal"; }
        bind "f" { ToggleFocusFullscreen; SwitchToMode "Normal"; }
        bind "z" { TogglePaneFrames; SwitchToMode "Normal"; }
        bind "w" { ToggleFloatingPanes; SwitchToMode "Normal"; }
        bind "n" { NewPane; SwitchToMode "Normal"; }
        bind "v" { NewPane "Right"; SwitchToMode "Normal"; }
        bind "s" { NewPane "Down"; SwitchToMode "Normal"; }
    }

    resize {
        bind "Esc" "Enter" "Alt R" { SwitchToMode "Normal"; }
        bind "h" { Resize "Increase Left"; }
        bind "j" { Resize "Increase Down"; }
        bind "k" { Resize "Increase Up"; }
        bind "l" { Resize "Increase Right"; }
        bind "H" { Resize "Decrease Left"; }
        bind "J" { Resize "Decrease Down"; }
        bind "K" { Resize "Decrease Up"; }
        bind "L" { Resize "Decrease Right"; }
        bind "=" "+" { Resize "Increase"; }
        bind "-"     { Resize "Decrease"; }
    }

    renametab {
        bind "Esc"   { UndoRenameTab; SwitchToMode "Normal"; }
        bind "Enter" { SwitchToMode "Normal"; }
    }

    renamepane {
        bind "Esc"   { UndoRenamePane; SwitchToMode "Normal"; }
        bind "Enter" { SwitchToMode "Normal"; }
    }

    session {
        bind "Esc" "Alt o" { SwitchToMode "Normal"; }
        bind "d" { Detach; }
        bind "w" {
            LaunchOrFocusPlugin "session-manager" {
                floating true
                move_to_focused_tab true
            }
            SwitchToMode "Normal"
        }
    }

    search {
        bind "Esc" "Alt /" { SwitchToMode "Normal"; }
        bind "Ctrl c"      { SwitchToMode "Normal"; }
        bind "Enter"       { Search "Down"; }
        bind "Ctrl r"      { Search "Up"; }
    }
}
